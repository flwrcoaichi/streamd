# TEXT TO SPEECH SETTINGS
TTS_ENABLED_DEFAULT     = 1
TTS_VOICES_DIR          = C:\Stream\voices
TTS_VOICE_PATH          = C:\Stream\voices\default.mp3
TTS_DEVICE              = cpu
TTS_ONNX_MODEL_DIR      = C:\Stream\chatterbox-nano-ONNX
TTS_ONNX_DTYPE          = q4f16
TTS_ONNX_PROVIDER       = cpu
TTS_MAX_NEW_TOKENS      = 512
TTS_TEMPERATURE         = 0.5
TTS_TOP_K               = 50
TTS_TOP_P               = 0.9
TTS_REPETITION_PENALTY  = 1.2
TTS_GREEDY              = 0

# YOUTUBE MUSIC (pear-desktop companion API + ytmusicapi search)
# setup:
#   1. in pear-desktop, enable the "api-server" companion plugin
#   2. run: python -m ytmusicapi browser   (saves to YTM_AUTH_HEADERS_PATH)
#   3. run: python run.py --ytm-auth       (pairs, saves companion token)
YTM_COMPANION_HOST     = 127.0.0.1
YTM_COMPANION_PORT     = 9863
YTM_COMPANION_APP_ID   = streamd
YTM_AUTH_HEADERS_PATH  = C:\Stream\ytm_headers_auth.json

# MUSIC VIDEO BACKGROUND CACHE
MV_DOWNLOAD_ENABLED = 1
MV_MAX_CACHE_BYTES  = 5368709120
